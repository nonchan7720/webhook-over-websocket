{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nonchan7720/renovate-config:golang"
  ],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "go.mod の go ディレクティブと mise の Go を Docker の golang イメージのタグ基準で更新し、Dockerfile と同じ golang version グループにまとめる（Docker イメージの公開が Go 本体のリリースより遅れるため、Docker 側に揃える）",
      "matchManagers": [
        "gomod",
        "mise"
      ],
      "matchDepNames": [
        "go"
      ],
      "overrideDatasource": "docker",
      "overridePackageName": "golang",
      "versioning": "docker",
      "extractVersion": "^(?<version>\\S+)$",
      "rangeStrategy": "bump",
      "pinDigests": false,
      "groupName": "golang version"
    }
  ]
}
